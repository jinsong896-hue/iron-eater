GameManager="*res://core/game_manager.gd"
SaveManager="*res://core/save_manager.gd"
AudioManager="*res://core/audio_manager.gd"
InputManager="*res://core/input_manager.gd"
SceneManager="*res://core/scene_manager.gd"
SettingsManager="*res://core/settings_manager.gd"
DebugManager="*res://core/debug_manager.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="噬铁者"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/iron_studio/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

