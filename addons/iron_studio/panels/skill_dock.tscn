[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://addons/iron_studio/panels/skill_dock.gd" id="1"]

[node name="SkillDock" type="Control"]
script = ExtResource("1")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Main" type="HSplitContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 4.0
offset_top = 4.0
offset_right = -4.0
offset_bottom = -4.0

[node name="Left" type="VBoxContainer" parent="Main"]
[node name="Title" type="Label" parent="Main/Left"]
text = "技能列表"
theme_override_font_sizes/font_size = 14
[node name="List" type="ItemList" parent="Main/Left"]
size_flags_vertical = 3
allow_reselect = true

[node name="Right" type="VBoxContainer" parent="Main"]
[node name="Title" type="Label" parent="Main/Right"]
text = "技能编辑"
theme_override_font_sizes/font_size = 14
[node name="Scroll" type="ScrollContainer" parent="Main/Right"]
size_flags_vertical = 3
[node name="VBox" type="VBoxContainer" parent="Main/Right/Scroll"]
theme_override_constants/separation = 6

[node name="Identity" type="VBoxContainer" parent="Main/Right/Scroll/VBox"]
[node name="Label" type="Label" parent="Main/Right/Scroll/VBox/Identity"]
text = "基本信息"
[node name="Name" type="LineEdit" parent="Main/Right/Scroll/VBox/Identity"]
placeholder_text = "技能名称"

[node name="Cost" type="VBoxContainer" parent="Main/Right/Scroll/VBox"]
[node name="Label" type="Label" parent="Main/Right/Scroll/VBox/Cost"]
text = "消耗与冷却"
[node name="HPCost" type="SpinBox" parent="Main/Right/Scroll/VBox/Cost"]
max_value = 100.0 ; suffix = "% HP消耗"
[node name="MPCost" type="SpinBox" parent="Main/Right/Scroll/VBox/Cost"]
max_value = 100.0 ; suffix = " MP消耗"
[node name="Cooldown" type="SpinBox" parent="Main/Right/Scroll/VBox/Cost"]
max_value = 60.0 ; value = 1.0 ; suffix = "s 冷却"

[node name="Visual" type="VBoxContainer" parent="Main/Right/Scroll/VBox"]
[node name="Label" type="Label" parent="Main/Right/Scroll/VBox/Visual"]
text = "表现"
[node name="Anim" type="LineEdit" parent="Main/Right/Scroll/VBox/Visual"]
placeholder_text = "动画名称"
[node name="VFX" type="LineEdit" parent="Main/Right/Scroll/VBox/Visual"]
placeholder_text = "特效路径"

[node name="Effects" type="VBoxContainer" parent="Main/Right/Scroll/VBox"]
[node name="Label" type="Label" parent="Main/Right/Scroll/VBox/Effects"]
text = "效果组合"
[node name="EffType" type="OptionButton" parent="Main/Right/Scroll/VBox/Effects"]
item_count = 2
popup/item_0/text = "伤害"
popup/item_1/text = "增益"
[node name="EffVal" type="SpinBox" parent="Main/Right/Scroll/VBox/Effects"]
max_value = 999.0 ; value = 1.0 ; step = 0.1
[node name="EffStat" type="OptionButton" parent="Main/Right/Scroll/VBox/Effects"]
item_count = 4
popup/item_0/text = "atk"
popup/item_1/text = "defense"
popup/item_2/text = "spd"
popup/item_3/text = "aspd"
[node name="EffBtnRow" type="HBoxContainer" parent="Main/Right/Scroll/VBox/Effects"]
[node name="AddEffBtn" type="Button" parent="Main/Right/Scroll/VBox/Effects/EffBtnRow"]
text = "+ 效果" ; size_flags_horizontal = 3
[node name="RemoveEffBtn" type="Button" parent="Main/Right/Scroll/VBox/Effects/EffBtnRow"]
text = "- 效果" ; size_flags_horizontal = 3
[node name="EffectList" type="ItemList" parent="Main/Right/Scroll/VBox/Effects"]
min_size = Vector2(0, 60)

[node name="BtnRow" type="HBoxContainer" parent="Main/Right/Scroll/VBox"]
theme_override_constants/separation = 4
[node name="NewBtn" type="Button" parent="Main/Right/Scroll/VBox/BtnRow"]
text = "新建" ; size_flags_horizontal = 3
[node name="LoadBtn" type="Button" parent="Main/Right/Scroll/VBox/BtnRow"]
text = "加载" ; size_flags_horizontal = 3
[node name="SaveBtn" type="Button" parent="Main/Right/Scroll/VBox/BtnRow"]
text = "保存" ; size_flags_horizontal = 3

[node name="Status" type="Label" parent="Main/Right/Scroll/VBox"]
text = "就绪"
theme_override_colors/font_color = Color(0.4, 0.9, 0.5, 1)

[connection signal="pressed" from="Main/Right/Scroll/VBox/Effects/EffBtnRow/AddEffBtn" to="." method="_on_add_effect_pressed"]
[connection signal="pressed" from="Main/Right/Scroll/VBox/Effects/EffBtnRow/RemoveEffBtn" to="." method="_on_remove_effect_pressed"]
[connection signal="pressed" from="Main/Right/Scroll/VBox/BtnRow/NewBtn" to="." method="_on_new_pressed"]
[connection signal="pressed" from="Main/Right/Scroll/VBox/BtnRow/LoadBtn" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Main/Right/Scroll/VBox/BtnRow/SaveBtn" to="." method="_on_save_pressed"]
[connection signal="item_activated" from="Main/Left/List" to="." method="_on_load_pressed"]
