## 缓存的索引：装备显示名 → 技能定义字典
static var _by_equip: Dictionary = {}
static var _built := false


static func _build() -> void:
	if _built:
		return
	_built = true
	for row in TABLE:
		var equip_name := str(row[0])
		var d := {
			"id": _skill_id(equip_name),
			"name": str(row[1]),
			"kind": str(row[2]),
			"cooldown": float(row[3]),
			"damage_mult": float(row[4]),
			"reach": float(row[5]),
			"duration": float(row[6]),
			"desc": str(row[7]),
			# 装备技能不消耗职业资源（规格：装备技能与职业无关）
			"cost": 0.0,
			"from_equipment": true,
			"source_equip": equip_name,
		}
		# **专属参数**（召唤/隐身类必需）：
		# 召唤靠 hp_ratio/atk_ratio/lifetime/count 才真的召出东西；
		# 隐身靠 stealth_seconds/next_hit_bonus/invuln 才有实际效果。
		# 缺这些字段时对应 kind 会「放了没反应」——故从表里逐项并入。
		var extra = row[8] if row.size() > 8 else {}
		if extra is Dictionary:
			for k in extra:
				d[str(k)] = extra[k]
		# **同装备名的多条技能**：规格里「元素爆发戒指」「战吼头盔」
		# 各有稀有版与传奇版**两件不同装备**，但重名。旧实现按
		# `_by_equip[装备名]` 存单条，后写覆盖前写——**2 个技能永远
		# 无法释放**（133 条只剩 131）。
		#
		# 改为按名存**数组**：同名多条并列，`skill_of_equipment` 再按
		# 稀有度挑最接近的一条。
		if _by_equip.has(equip_name):
			var arr: Array = _by_equip[equip_name]
			arr.append(d)
			_by_equip[equip_name] = arr
		else:
			_by_equip[equip_name] = [d]


## 装备技能 id（按装备名唯一化）
##
## **同一件装备只会有一个技能**——重名的两件装备（稀有版/传奇版）
## 各有各的数值，但技能名相同，故 id 也相同。这不是冲突：
## 玩家的技能槽按 id 记，装上哪一版放的都是同一个技能，只是数值取
## 自己装备的那一版（见 `skill_of_equipment` 的稀有度选择）。
static func _skill_id(equip_name: String) -> String:
	return "eq_" + equip_name


## 按装备名取技能定义（没有则空字典）
##
## `rarity` 用于**同名多版**消歧：规格里「元素爆发戒指」有稀有版
##（100% 法强 / 14 秒）与传奇版（300% 法强 / 20 秒），两件装备重名。
## 传入装备稀有度时挑最接近的一版；不传（-1）取第一条。
static func skill_of_equipment(equip_name: String, rarity: int = -1) -> Dictionary:
	_build()
	var v = _by_equip.get(equip_name, null)
	if v == null:
		return {}
	if v is Array:
		var arr: Array = v
		if arr.is_empty():
			return {}
		if rarity < 0 or arr.size() == 1:
			return arr[0]
		return _pick_by_rarity(arr, rarity)
	return v


## 从同名多版里挑最接近目标稀有度的一条
##
## 稀有度档位是 0..5（白绿蓝紫橙红，`EquipmentDefs.Rarity`），但同名
## 多版只有 2 条（稀有/传奇）。**不能直接 clampi(rarity, 0, size-1)**：
## 传奇装备 rarity=4（ORANGE），clampi(4,0,1)=1 会取到**弱的那条**——
## 正是本次要修的覆盖 bug。
##
## 正确做法：把目标稀有度**按档位比例**映射到条目下标。
## 例如 2 条时，rarity 0..2 → 下标 0，3..5 → 下标 1。
static func _pick_by_rarity(arr: Array, rarity: int) -> Dictionary:
	if arr.size() <= 1:
		return arr[0]
	var n := arr.size()
	# rarity 0..5 → 0..n-1（用 (n-1) 等分 6 档）
	var idx := int(round(float(rarity) / 5.0 * float(n - 1)))
	return arr[clampi(idx, 0, n - 1)]


## 按技能 id 取定义（没有则空字典）
static func skill_by_id(skill_id: String) -> Dictionary:
	_build()
	for v in _by_equip.values():
		if v is Array:
			for d in v:
				if str(d.get("id", "")) == skill_id:
					return d
		elif str(v.get("id", "")) == skill_id:
			return v
	return {}


## 全部装备技能（供技能管理页的「装备技能」分栏）
static func all_skills() -> Array:
	_build()
	var out: Array = []
	for v in _by_equip.values():
		if v is Array:
			out.append_array(v)
		else:
			out.append(v)
	return out


## 玩家当前**已装备**的装备所提供的技能列表。
##
## 这是技能管理页可选池里「装备技能」那一栏的数据源。
static func available_for(equipment_manager) -> Array:
	_build()
	var out: Array = []
	if equipment_manager == null:
		return out
	for inst in equipment_manager.get_equipped().values():
		if inst == null:
			continue
		var tpl = inst.get_template()
		if tpl == null:
			continue
		var d: Dictionary = skill_of_equipment(tpl.display_name, int(tpl.rarity))
		if not d.is_empty():
			out.append(d)
	return out


## 某个技能 id 是否来自装备
static func is_equipment_skill(skill_id: String) -> bool:
	return not skill_by_id(skill_id).is_empty()




