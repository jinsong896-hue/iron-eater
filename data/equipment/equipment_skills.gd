## 缓存的索引：装备显示名 → 技能定义字典
static var _by_equip: Dictionary = {}
static var _built := false


static func _build() -> void:
	if _built:
		return
	_built = true
	for row in TABLE:
		var equip_name := str(row[0])
		_by_equip[equip_name] = {
			"id": _skill_id(equip_name),
			"name": str(row[1]),
			"kind": str(row[2]),
			"cooldown": float(row[3]),
			"damage_mult": float(row[4]),
			"reach": float(row[5]),
			"duration": float(row[6]),
			"desc": str(row[7]),
			# 装备技能不消耗职业资源（规格：装备技能与职业无关）
			"cost": 0.0,
			"from_equipment": true,
			"source_equip": equip_name,
		}


## 装备技能 id（按装备名唯一化）
static func _skill_id(equip_name: String) -> String:
	return "eq_" + equip_name


## 按装备显示名取技能定义（没有则空字典）
static func skill_of_equipment(equip_name: String) -> Dictionary:
	_build()
	return _by_equip.get(equip_name, {})


## 按技能 id 取定义（没有则空字典）
static func skill_by_id(skill_id: String) -> Dictionary:
	_build()
	for d in _by_equip.values():
		if str(d.get("id", "")) == skill_id:
			return d
	return {}


## 全部装备技能（供技能管理页的「装备技能」分栏）
static func all_skills() -> Array:
	_build()
	return _by_equip.values()


## 玩家当前**已装备**的装备所提供的技能列表。
##
## 这是技能管理页可选池里「装备技能」那一栏的数据源。
static func available_for(equipment_manager) -> Array:
	_build()
	var out: Array = []
	if equipment_manager == null:
		return out
	for inst in equipment_manager.get_equipped().values():
		if inst == null:
			continue
		var tpl = inst.get_template()
		if tpl == null:
			continue
		var d: Dictionary = _by_equip.get(tpl.display_name, {})
		if not d.is_empty():
			out.append(d)
	return out


## 某个技能 id 是否来自装备
static func is_equipment_skill(skill_id: String) -> bool:
	_build()
	for d in _by_equip.values():
		if str(d.get("id", "")) == skill_id:
			return true
	return false
