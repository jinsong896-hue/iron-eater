[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/editor/room_editor.gd" id="1"]
[ext_resource type="TileSet" path="res://rooms/editor/editor_tileset.tres" id="2"]

[node name="RoomEditor" type="Node2D"]
script = ExtResource("1")

[node name="FloorLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
z_index = 0

[node name="DetailLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
z_index = 1

[node name="WallLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
z_index = 2

[node name="ObstacleLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
z_index = 3

[node name="InteractLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
z_index = 4

[node name="SpawnMarkers" type="Node2D" parent="."]

[node name="ChestMarkers" type="Node2D" parent="."]

[node name="PlayerSpawn" type="Marker2D" parent="."]

[node name="UI" type="CanvasLayer" parent="."]

[node name="Panel" type="Panel" parent="UI"]
offset_left = 8.0
offset_top = 8.0
offset_right = 260.0
offset_bottom = 520.0

[node name="VBox" type="VBoxContainer" parent="UI/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="UI/Panel/VBox"]
text = "房间编辑器"
theme_override_font_sizes/font_size = 15
horizontal_alignment = 1

[node name="NameRow" type="HBoxContainer" parent="UI/Panel/VBox"]
theme_override_constants/separation = 4

[node name="NameInput" type="LineEdit" parent="UI/Panel/VBox/NameRow"]
text = "room_01"
size_flags_horizontal = 3

[node name="NewBtn" type="Button" parent="UI/Panel/VBox/NameRow"]
text = "新建"

[node name="Sep1" type="HSeparator" parent="UI/Panel/VBox"]

[node name="BtnRow" type="GridContainer" parent="UI/Panel/VBox"]
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 4
columns = 2

[node name="SaveBtn" type="Button" parent="UI/Panel/VBox/BtnRow"]
text = "保存"
size_flags_horizontal = 3

[node name="LoadBtn" type="Button" parent="UI/Panel/VBox/BtnRow"]
text = "加载"
size_flags_horizontal = 3

[node name="FillBtn" type="Button" parent="UI/Panel/VBox/BtnRow"]
text = "填充地板"
size_flags_horizontal = 3

[node name="ClearBtn" type="Button" parent="UI/Panel/VBox/BtnRow"]
text = "清空"
size_flags_horizontal = 3

[node name="NextBtn" type="Button" parent="UI/Panel/VBox/BtnRow"]
text = "下一个"
size_flags_horizontal = 3

[node name="Sep2" type="HSeparator" parent="UI/Panel/VBox"]

[node name="ListLabel" type="Label" parent="UI/Panel/VBox"]
text = "已保存房间（双击加载）:"

[node name="RoomList" type="ItemList" parent="UI/Panel/VBox"]
size_flags_vertical = 3
allow_reselect = true

[node name="Status" type="Label" parent="UI/Panel/VBox"]
text = "就绪"
theme_override_colors/font_color = Color(0.4, 0.9, 0.5, 1)
theme_override_font_sizes/font_size = 11
autowrap_mode = 2

[connection signal="pressed" from="UI/Panel/VBox/NameRow/NewBtn" to="." method="_on_new_pressed"]
[connection signal="pressed" from="UI/Panel/VBox/BtnRow/SaveBtn" to="." method="_on_save_pressed"]
[connection signal="pressed" from="UI/Panel/VBox/BtnRow/LoadBtn" to="." method="_on_load_pressed"]
[connection signal="pressed" from="UI/Panel/VBox/BtnRow/FillBtn" to="." method="_on_fill_pressed"]
[connection signal="pressed" from="UI/Panel/VBox/BtnRow/ClearBtn" to="." method="_on_clear_pressed"]
[connection signal="pressed" from="UI/Panel/VBox/BtnRow/NextBtn" to="." method="_on_next_pressed"]
[connection signal="item_activated" from="UI/Panel/VBox/RoomList" to="." method="_on_list_activated"]