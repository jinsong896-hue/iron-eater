[node name="RefreshBtn" type="Button" parent="UI/Panel/VBox"]
text = "刷新列表"

[node name="Sep2" type="HSeparator" parent="UI/Panel/VBox"]

[node name="Instructions" type="Label" parent="UI/Panel/VBox"]
text = "步骤：
1. 输入名称 → 点「新建」
2. 在场景树选图层 → 画瓦片
3. 点「保存」
4. 点「下一个」画新房间"
theme_override_font_sizes/font_size = 11
autowrap_mode = 2

[node name="Status" type="Label" parent="UI/Panel/VBox"]
text = "输入名称 → 点「新建」"
theme_override_colors/font_color = Color(0.4, 0.9, 0.5, 1)
theme_override_font_sizes/font_size = 11
autowrap_mode = 2

