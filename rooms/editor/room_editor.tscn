[node name="Sep0" type="HSeparator" parent="UI/Panel/VBox"]

[node name="NewBtn" type="Button" parent="UI/Panel/VBox"]
text = "新建"

[node name="SaveBtn" type="Button" parent="UI/Panel/VBox"]
text = "保存"

[node name="NextBtn" type="Button" parent="UI/Panel/VBox"]
text = "下一个"

[node name="FillBtn" type="Button" parent="UI/Panel/VBox"]
text = "填充地板 (16×12)"

[node name="Sep1" type="HSeparator" parent="UI/Panel/VBox"]

[node name="ListLabel" type="Label" parent="UI/Panel/VBox"]
