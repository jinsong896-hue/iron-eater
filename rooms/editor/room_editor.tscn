[node name="PlayerSpawn" type="Marker2D" parent="."]

[node name="UI" type="CanvasLayer" parent="."]

[node name="Panel" type="Panel" parent="UI"]
offset_left = 8.0
offset_top = 8.0
offset_right = 260.0
offset_bottom = 540.0

[node name="VBox" type="VBoxContainer" parent="UI/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="UI/Panel/VBox"]
text = "房间编辑器"
theme_override_font_sizes/font_size = 15
horizontal_alignment = 1

[node name="NameLabel" type="Label" parent="UI/Panel/VBox"]
text = "房间名称:"

[node name="NameInput" type="LineEdit" parent="UI/Panel/VBox"]
text = "room_01"
